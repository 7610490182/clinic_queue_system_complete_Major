# Server Port
PORT=5000

# Client Application URL
CLIENT_URL=http://localhost:5173

# JWT Secret for Session Authentication
JWT_SECRET=supersecretclinicqueuekey2026!

# MongoDB Connection String:
# Option 1: Local MongoDB (Default - Runs on Port 27017 with persistent WiredTiger disk storage)
MONGO_URI=mongodb://localhost:27017/clinic-queue

# Option 2: MongoDB Atlas Cloud (Uncomment and replace with your cluster URI)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/clinic-queue?retryWrites=true&w=majority

# Razorpay Payment Gateway Keys (Mock Mode will auto-activate if dummy values are kept)
RAZORPAY_KEY_ID=dummy_razorpay_key_id
RAZORPAY_KEY_SECRET=dummy_razorpay_key_secret
